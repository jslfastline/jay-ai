# Jay AI app environment (public values only — NEVER put provider keys here).
# Expo inlines only EXPO_PUBLIC_* variables at build time.

# Backend URL (your laptop's LAN IP, no trailing slash).
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.108:8787

# Must be 'false' to leave mock mode when a backend URL is set.
EXPO_PUBLIC_USE_MOCK=false

# Network request timeout in milliseconds.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=30000

# Optional sample video used ONLY as a labelled mock preview (must be a public .mp4).
EXPO_PUBLIC_MOCK_SAMPLE_VIDEO_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4

# 'false' disables placeholder demo images in mock mode.
EXPO_PUBLIC_MOCK_PLACEHOLDER_IMAGES=true

# Chat attachment limits (enforced client-side before upload).
EXPO_PUBLIC_ATTACHMENT_MAX_MB=15
EXPO_PUBLIC_MAX_ATTACHMENTS=6
