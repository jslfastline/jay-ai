# Jay AI — environment example
#
# Copy this file to `.env` and fill in values as needed:
#   cp .env.example .env
#
# Only `EXPO_PUBLIC_*` variables are inlined into the app bundle.
# NEVER put private AI provider API keys, admin credentials, or secrets here.
# Keep those on your backend only.

# Base URL of the Jay AI backend (no trailing slash).
# When empty, the app runs in explicit MOCK mode.
EXPO_PUBLIC_API_BASE_URL=

# Force mock mode even when a backend is configured: 'true' or 'false'.
EXPO_PUBLIC_USE_MOCK=true

# Network request timeout in milliseconds.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=30000

# Optional sample video used ONLY as a labelled mock preview (must be a public .mp4).
EXPO_PUBLIC_MOCK_SAMPLE_VIDEO_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4

# 'false' disables placeholder demo images in mock mode.
EXPO_PUBLIC_MOCK_PLACEHOLDER_IMAGES=true

# Chat attachment limits (enforced client-side before upload).
EXPO_PUBLIC_ATTACHMENT_MAX_MB=15
EXPO_PUBLIC_MAX_ATTACHMENTS=6

# --- Backend (server/) configuration lives in server/.env, NOT here ---
# See server/.env.example. Provider keys (e.g. OPENAI_API_KEY) must only ever
# be set on the server. The app talks to the backend via EXPO_PUBLIC_API_BASE_URL.