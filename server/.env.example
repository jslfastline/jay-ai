# Jay AI backend configuration.
# Copy this file to `server/.env` and fill in your provider credentials.
# These secrets stay on the server only — never ship them in the mobile app.

# --- Provider (OpenAI-compatible) --------------------------------------------
# Works with OpenAI, OpenRouter, Groq, Together, Azure-compatible gateways,
# and local servers such as Ollama (http://host:11434/v1).
OPENAI_API_KEY=
# Optional: override the API base. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Chat model used for conversations.
OPENAI_MODEL=gpt-4o-mini
# Model used for image analysis (defaults to OPENAI_MODEL when unset).
OPENAI_VISION_MODEL=
# Set to "true" only if your provider/model accepts video input in chat turns.
OPENAI_VIDEO_SUPPORTED=false
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048
# Retries on provider rate limits (429) and temporary errors (5xx). Set 0 to disable.
PROVIDER_MAX_RETRIES=3
# Base backoff between retries, in milliseconds (grows exponentially, capped at 8s).
PROVIDER_RETRY_BASE_MS=800

# --- Accounts (authentication) -----------------------------------------------
# Secret used to sign session tokens. REQUIRED in production — generate a long
# random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, the server generates an ephemeral secret (sessions reset on restart).
JWT_SECRET=
# How long a signed-in session lasts.
JWT_EXPIRES_IN=30d
# How long an emailed verification code stays valid, in minutes.
VERIFY_TTL_MINUTES=10

# --- Transactional email (EmailJS) -------------------------------------------
# Sends verification links on sign-up. Create a free account at
# https://www.emailjs.com, add an email service + template, then paste the IDs.
# The template must include these variables: {{to_name}} {{verification_link}}
# (optionally also {{to_email}} {{code}} {{app_name}} {{expiry_minutes}}).
#
# The link points at PUBLIC_BASE_URL, so it must be reachable from the phone
# (use your LAN IP, e.g. http://192.168.0.108:8787), otherwise set an https domain.
#
# When these are left blank, codes are printed to this server's console instead
# (and, outside production, returned to the app as a development code).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional: enables authenticated server-side sends. Keep this secret.
EMAILJS_PRIVATE_KEY=
EMAIL_APP_NAME=Jay AI

# --- Server ------------------------------------------------------------------
PORT=8787
# Public URL used inside emailed links. Set to your LAN IP for local testing.
PUBLIC_BASE_URL=http://192.168.0.108:8787
# Max size of each uploaded attachment, in megabytes.
MAX_UPLOAD_MB=15
# Comma-separated allowed origins, or "*" for any (development default).
CORS_ORIGIN=*
REQUEST_TIMEOUT_MS=120000
